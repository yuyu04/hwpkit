{
  "name": "hwpkit",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Read and write Korean HWP/HWPX documents (한글) — a Claude skill/plugin and CLI powered by the rhwp WASM engine. Runs locally, no server.",
  "license": "MIT",
  "author": "sungju Yun",
  "homepage": "https://github.com/yuyu04/hwpkit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuyu04/hwpkit.git"
  },
  "bugs": {
    "url": "https://github.com/yuyu04/hwpkit/issues"
  },
  "keywords": [
    "hwp",
    "hwpx",
    "한글",
    "hancom",
    "korean",
    "owpml",
    "document",
    "claude",
    "cowork",
    "agent-skill"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "hwp-read": "scripts/hwp-read.mjs",
    "hwp-write": "scripts/hwp-write.mjs",
    "hwp-preview": "scripts/hwp-preview.mjs",
    "hwp-mcp": "scripts/hwp-mcp.mjs"
  },
  "scripts": {
    "test": "node --test test/roundtrip.test.mjs test/mcp.test.mjs",
    "mcp": "node scripts/hwp-mcp.mjs",
    "example": "node scripts/hwp-write.mjs examples/sample.md examples/sample.hwp && node scripts/hwp-write.mjs examples/sample.md examples/sample.hwpx",
    "example:preview": "node scripts/hwp-preview.mjs examples/sample.hwp docs/images --png --scale 2 --pages 1"
  },
  "dependencies": {
    "cfb": "^1.2.2"
  }
}
